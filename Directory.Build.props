<Project>
  <PropertyGroup>
    <TargetFramework>net462</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <Deterministic>true</Deterministic>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <ValheimServerDir>$(MSBuildThisFileDirectory)..\..</ValheimServerDir>
    <ValheimManagedDir>$(ValheimServerDir)\valheim_server_Data\Managed</ValheimManagedDir>
    <BepInExDir>$(ValheimServerDir)\BepInEx</BepInExDir>
    <BepInExCoreDir>$(BepInExDir)\core</BepInExCoreDir>
    <JotunnDir>$(BepInExDir)\plugins\ValheimModding-Jotunn</JotunnDir>
  </PropertyGroup>
</Project>
